# ── PostgreSQL Connection ──────────────────────────────────────────
# Local development (default when you run PostgreSQL on your machine)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=econtrack
DB_USER=postgres
DB_PASSWORD=your_password_here

# ── Server ─────────────────────────────────────────────────────────
PORT=3001

# ── Real-time update interval (milliseconds) ───────────────────────
WS_TICK_MS=3000

# ── Optional: Neon / Supabase / Railway cloud DB ──────────────────
# Replace the above DB_* values with these if using a cloud provider:
# DATABASE_URL=postgresql://user:password@host:5432/econtrack?sslmode=require
